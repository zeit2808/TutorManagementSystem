{
  "Frontend": {
    "BaseUrl": ""
  },
  "ConnectionStrings": {
    "MainDatabase": "Host=localhost;Port=5432;Database=tutor_management;Username=tutor_app"
  },
  "Jwt": {
    "Issuer": "TutorManagement.Api",
    "Audience": "TutorManagement.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "Authentication": {
    "RefreshCookie": {
      "Name": "tm.refresh",
      "Path": "/api/v1/auth",
      "SameSite": "Lax",
      "Secure": true
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimit": {
    "LoginPermitLimit": 30,
    "LoginWindowSeconds": 60,
    "TrustedProxies": []
  },
  "RequestPerformance": {
    "SlowRequestThresholdMilliseconds": 1000,
    "LoginSlowRequestThresholdMilliseconds": 2000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
